# ==============================================================================
# CivicTrust Environment Configuration
# ==============================================================================

# LOCAL REQUIRED VARIABLES
# ------------------------------------------------------------------------------
# Database Provider (sqlite | postgres)
DATABASE_PROVIDER=sqlite

# NextAuth / Session Secret Key (Must be generated for local use as well)
NEXTAUTH_SECRET=generate_a_secure_random_secret_token_here
NEXTAUTH_URL=http://localhost:3000

# Application Environment
NODE_ENV=development

# FUTURE PRODUCTION VARIABLES
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL (Supabase)
# Example format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=

# Database Connection Pool Settings (Optional)
# Maximum connections in the pool (Default: 20)
DB_POOL_MAX=20

# SSL Settings for Managed PostgreSQL (Set to true if cloud DB requires SSL)
DATABASE_SSL=false
# Set to true to enforce strict SSL certificate verification in production
DB_REJECT_UNAUTHORIZED=false

# Development-Only Fallback Setting (Must be false in production)
MOCK_MODE=false
