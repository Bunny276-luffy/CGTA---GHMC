# ==============================================================================
# CivicTrust Environment Configuration
# ==============================================================================

# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'sqlite' for local development or 'postgres' for production/Supabase
DATABASE_PROVIDER=sqlite

# NextAuth / Session Secret Key (Must be generated for local use as well)
NEXTAUTH_SECRET=generate_a_secure_random_secret_token_here
NEXTAUTH_URL=http://localhost:3000

# Application Environment
NODE_ENV=development

# POSTGRESQL (SUPABASE) VARIABLES
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL (Supabase Session Pooler on Port 5432)
# Example format: postgresql://postgres.[project-ref]:[url-encoded-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Database Connection Pool Settings (Required for Serverless/Supabase Session Pooler)
# Keep low for serverless (e.g., 5)
DB_POOL_MAX=5

# SSL Settings for Managed PostgreSQL
DATABASE_SSL=true
# Must be false if standard TLS certificates aren't available locally/on edge
DB_REJECT_UNAUTHORIZED=false

# Development-Only Fallback Setting (Must be false in production)
MOCK_MODE=false
