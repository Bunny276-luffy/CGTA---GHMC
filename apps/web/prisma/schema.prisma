datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum Status {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  TPA_REVIEW
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CITIZEN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  complaintsCreated  Complaint[]    @relation("CitizenComplaints")
  complaintsAssigned Complaint[]    @relation("OfficerComplaints")
  notifications      Notification[]
}

model Complaint {
  id                String   @id @default(uuid())
  trackingId        String   @unique
  title             String
  description       String
  category          String
  status            Status   @default(SUBMITTED)
  latitude          Float
  longitude         Float
  address           String
  severity          String   @default("STANDARD")
  anonymous         Boolean  @default(false)
  beforePhotoUrl    String?
  resolutionPhotoUrl String?
  rejectionCount    Int      @default(0)
  citizenConfirmed  Boolean  @default(false)
  closedByTPA       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdById       String
  assignedOfficerId String?

  createdBy       User         @relation("CitizenComplaints", fields: [createdById], references: [id])
  assignedOfficer User?        @relation("OfficerComplaints", fields: [assignedOfficerId], references: [id])
  evidence        Evidence[]
  aiReport        AiReport?
}

model Evidence {
  id          String   @id @default(uuid())
  complaintId String
  fileUrl     String
  fileType    String
  sizeBytes   Int
  metadata    Json?
  uploadedAt  DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model AiReport {
  id                 String   @id @default(uuid())
  complaintId        String   @unique
  exifData           Json?
  duplicateDetected  Boolean  @default(false)
  duplicateParentId  String?
  forgeryScore       Float    @default(0.0)
  trustScore         Float    @default(100.0)
  explainableReport  String   @db.Text
  priorityPredicted  String   @default("STANDARD")
  checkedAt          DateTime @default(now())

  complaint          Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  details    String   @db.Text
  ipAddress  String?
  timestamp  DateTime @default(now())
}
